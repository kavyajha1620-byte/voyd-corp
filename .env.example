# Local preview secrets for the VOYD testimonials API. Never commit this file.
# Copy to .env.local and fill in real values.

# Protects /api/admin, private screenshots, and admin reads of /api/entries.
# Must be 16+ characters. Send as: Authorization: Bearer <token>
VOYD_ADMIN_TOKEN=

# Storage backend: filesystem | supabase | none
# Leave unset locally to use the filesystem driver.
VOYD_STORAGE=filesystem
# Where the filesystem driver keeps db.json + uploads/ (outside the repo by default).
VOYD_DATA_DIR=

# Supabase (production). All three are required for the supabase driver.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=voyd-screenshots
SUPABASE_TABLE=testimonials
